# E2E build config, loaded by `vite build --mode e2e`.
#
# Why this file exists: `vite build` defaults to `--mode production`, which loads
# .env.production and bakes its absolute API URL into the bundle. That pointed the
# Playwright run at the REAL production API instead of the local backend.
#
# Vite only loads .env.<mode>, so building with --mode e2e skips .env.production
# entirely. The relative "/api" then travels through the preview proxy
# (see preview.proxy in vite.config.ts) to the local E2E backend.
VITE_API_URL=/api
