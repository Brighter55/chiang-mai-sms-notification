SECRET_KEY=your-django-secret-key-here
DEBUG=True
# PostgreSQL (uncomment and fill in when ready):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/clover_notify
# For dev with zero setup, Django falls back to SQLite below:
DATABASE_URL=sqlite:///db.sqlite3

# Clover (manual sync — merchant-generated API token, no app approval needed)
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=
# Set to False once you have a production token (default True = sandbox API)
CLOVER_USE_SANDBOX=True
# How far back each manual sync looks (days)
CLOVER_SYNC_LOOKBACK_DAYS=2

# Twilio credentials (fill in to enable real SMS sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Merchant info (used in SMS template)
MERCHANT_NAME=Your Shop Name
